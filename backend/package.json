{
  "name": "devmatch-backend",
  "version": "1.0.0",
  "description": "DevMatch backend — Node.js + Express + Prisma + PostgreSQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed_devmatch.js",
    "test:concurrency": "node scripts/reproduce-race-condition.js",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "devmatch",
    "express",
    "prisma",
    "postgres",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^2.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1",
    "rate-limit-redis": "^6.0.2",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
